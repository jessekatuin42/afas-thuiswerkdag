# Browser session data — NEVER commit. Contains cookies/tokens for AFAS.
.browser-profile/

# Diagnostics (screenshots, traces, DOM dumps) may contain personal data.
artifacts/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Local config overrides
config.local.toml

# Credentials — NEVER commit. Contains password and TOTP secret.
.env

# Container-side browser session (seeded copy of .browser-profile)
.browser-profile-docker/

# Local planner database (your plan and sync history)
data/

# Shuttel refresh token -- a credential. NEVER commit.
.shuttel-token.json

# Shuttel login browser profile
.shuttel-browser-profile/
