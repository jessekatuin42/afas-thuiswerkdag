# Copy to .env and fill in. .env is gitignored — never commit it.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Only AFAS_TENANT is required. The three credential values are optional:
# anything you leave blank simply falls back to you typing it in the browser.

# REQUIRED. Your AFAS InSite environment number — the leading digits of your
# portal hostname:  https://12345.afasinsite.nl  =>  AFAS_TENANT=12345
AFAS_TENANT=

# Your AFAS login e-mail / username.
AFAS_USERNAME=

# Your AFAS password.
AFAS_PASSWORD=

# The TOTP *secret* from AFAS 2FA setup — the base32 string behind the QR code
# (looks like JBSWY3DPEHPK3PXP), NOT the 6-digit code shown in your app.
# If you only have the QR image, use the "can't scan / manual entry" option in
# AFAS to reveal the secret.
AFAS_TOTP_SECRET=

# Optional: explicit Chromium binary, if auto-detection picks the wrong one.
# AFAS_CHROMIUM=/usr/bin/chromium

# ---------------------------------------------------------------------------
# SECURITY NOTE
#
# Storing the password and the TOTP secret in the same file means both factors
# live in one place, so this is closer to single-factor auth than real 2FA.
# That is a deliberate trade-off for unattended automation. Keep .env at
# chmod 600, keep it out of git and out of backups, and prefer filling in only
# AFAS_TOTP_SECRET (typing the password yourself) if you want to keep the
# factors separated.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Shuttel (mijn.shuttel.nl) -- commute km reimbursement for office days.
#
# Separate system from AFAS, with its own login. The portal authenticates
# through Keycloak; the tooling uses the password grant, so no browser is
# involved and no TOTP is required.
# ---------------------------------------------------------------------------

SHUTTEL_USERNAME=
SHUTTEL_PASSWORD=
